### Health check
GET http://localhost:8080/health

### Admin login
# @name adminLogin
POST http://localhost:8080/auth/login
Content-Type: application/json

{
  "email": "admin@toro.local",
  "password": "admin123"
}

### Protected admin route without token — expected 401
GET http://localhost:8080/admin/ping

### Protected admin route with seller token — expected 403
# Execute seller login first and replace the value below.
GET http://localhost:8080/admin/ping
Authorization: Bearer <seller-token>

### Protected admin route with admin token — expected 200
GET http://localhost:8080/admin/ping
Authorization: Bearer <admin-token>

### Create product — admin
POST http://localhost:8080/products
Authorization: Bearer <admin-token>
Content-Type: application/json

{
  "name": "Produto HTTP",
  "sku": "PROD-HTTP",
  "points_per_unit": 100
}

### List products — admin
GET http://localhost:8080/products
Authorization: Bearer <admin-token>

### Update product — admin
PUT http://localhost:8080/products/1
Authorization: Bearer <admin-token>
Content-Type: application/json

{
  "name": "Produto HTTP atualizado",
  "sku": "PROD-HTTP",
  "points_per_unit": 125
}

### Inactivate product — admin
DELETE http://localhost:8080/products/1
Authorization: Bearer <admin-token>

### Create campaign — admin
POST http://localhost:8080/campaigns
Authorization: Bearer <admin-token>
Content-Type: application/json

{
  "name": "Campanha HTTP",
  "budget_total": 10000,
  "starts_at": "2026-10-01 00:00:00",
  "ends_at": "2026-10-31 23:59:59"
}

### List campaigns — admin
GET http://localhost:8080/campaigns
Authorization: Bearer <admin-token>

### Create sale — admin
POST http://localhost:8080/sales
Authorization: Bearer <admin-token>
Content-Type: application/json

{
  "external_id": "erp-sale-1001",
  "campaign_id": 1,
  "seller_id": 2,
  "product_id": 1,
  "quantity": 3,
  "unit_value": "149.90"
}

{
  "name": "jonatas-soares-gama/desafio-toro-backend",
  "description": "API da plataforma Vendeu, Ganhou",
  "type": "project",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit tests/Unit"
  },
  "config": {
    "sort-packages": true
  }
}
